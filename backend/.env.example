# Copy to backend/.env (gitignored). Never commit real keys.
CARTESIA_API_KEY=
# Optional: Spanish (es-MX) Sonic voice id; auto-discovered from /voices when empty
CARTESIA_VOICE_ID=
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-2
CARTESIA_PRONUNCIATION_DICT_ID=
# Required for the applicant chat (Claude drives it); also enables Claude staff agents and vision extraction
ANTHROPIC_API_KEY=
# Postgres recommended (LISTEN/NOTIFY + SKIP LOCKED); SQLite default for zero-setup dev.
# Supabase: Dashboard -> Connect -> Session pooler (port 5432; IPv4). The direct db.<ref>.supabase.co host is IPv6-only.
# A pasted postgresql:// URL works as-is (rewritten to psycopg 3, sslmode=require added).
DATABASE_URL=postgresql+psycopg://ellis:ellis@localhost:5432/ellis
# File storage: set both to use a private Supabase Storage bucket (created on first use); unset = ELLIS_FILES_DIR on disk.
# Secret key = Project Settings -> API Keys -> secret (sb_secret_...) or legacy service_role. Server-side only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=case-files
ELLIS_TOOL_SECRET=change-me
ELLIS_SESSION_SECRET=change-me
# 32 random bytes, base64 (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
VAULT_KEY=
# skeleton | anthropic | creao
ELLIS_AGENT_BACKEND=skeleton
CREAO_BASE_URL=https://agent.creao.ai
# One API key + app id per staff agent (backends.py reads <AGENT>_API_KEY / <AGENT>_APP_ID, where AGENT
# is the agent's own name -- case_manager, doc_paralegal, docketing_clerk, qa_reviewer).
CASE_MANAGER_API_KEY=
CASE_MANAGER_APP_ID=
DOC_PARALEGAL_API_KEY=
DOC_PARALEGAL_APP_ID=
DOCKETING_CLERK_API_KEY=
DOCKETING_CLERK_APP_ID=
QA_REVIEWER_API_KEY=
QA_REVIEWER_APP_ID=
# Required before setting ELLIS_AGENT_BACKEND=creao: the webhook at /webhooks/creao refuses every request
# without it (it writes case data, so there's no safe unauthenticated default).
CREAO_WEBHOOK_SECRET=
ELLIS_PUBLIC_BASE_URL=http://localhost:5173
# Pin "today" for the demo (flows are written for Fri Oct 23, 2026); empty = real date
ELLIS_TODAY=
